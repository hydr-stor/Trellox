{
  "name": "riwaq-commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node scripts/worker.mjs dev --local --port 8787",
    "db:migrate": "node scripts/worker.mjs d1 migrations apply DB --local",
    "db:seed": "node scripts/seed.mjs",
    "subscription:grant": "node scripts/grant.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/worker.mjs deploy --dry-run --outdir dist/worker",
    "test": "esbuild server/index.ts --bundle --format=esm --platform=browser --outfile=.test-worker/index.js && vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:boundaries": "node tests/boundaries.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "hono": "^4.10.0",
    "zod": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "miniflare": "4.20260730.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.45.0",
    "@fontsource-variable/noto-sans-arabic": "^5.2.0",
    "@playwright/test": "^1.56.0"
  },
  "overrides": {
    "miniflare@4.20260730.0": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    }
  }
}
