{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riwaq-local-foundation", "main": "server/index.ts", "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "vars": {"APP_ENV":"local"},
  "assets": {"directory":"dist/client","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
  "d1_databases": [{"binding":"DB","database_name":"riwaq-new-local","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"IMAGES","bucket_name":"riwaq-new-local-images"}]
}
