{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trellox",
  "main": "server/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "production"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trellox-db",
      "database_id": "2a3e12d7-83f2-4784-b96c-b500c97c771b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "trellox-images"
    }
  ]
}
